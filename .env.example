# ExecFlex Backend Environment Variables
# Copy this file to .env and fill in your actual values
# 
# IMPORTANT: Never commit .env to git (it's in .gitignore)

# ============================================================================
# REQUIRED - Core Functionality
# ============================================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
# Must be the **service role key** (has admin access), not the anon key
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Email Configuration (for sending introduction emails)
EMAIL_USER=your-email@gmail.com
# Must be an **app password** if using Gmail with 2FA
EMAIL_PASS=your-app-password-here

# Server Port usually auto-set by platform (onrender)
# For local development, default is 5001
# PORT=5001

# ============================================================================
# OPTIONAL - Email Configuration
# ============================================================================

# SMTP Configuration (optional - uses Gmail defaults if not set)
# Only needed if using non-Gmail SMTP server
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465

# ============================================================================
# OPTIONAL - Voice/Telephony Features
# ============================================================================

# Twilio Configuration (required for voice calls)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Must be in E.164 format (starts with `+`, includes country code)
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# OPTIONAL - Text-to-Speech Features
# ============================================================================

# ElevenLabs Configuration (required for TTS in voice calls)
# ELEVEN_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ELEVEN_VOICE_ID=your-voice-id-here

# ============================================================================
# OPTIONAL - AI Conversation Features
# ============================================================================

# OpenAI Configuration (required for GPT conversation rephrasing)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# OPTIONAL - Stripe Billing
# ============================================================================

# Stripe Configuration (required for billing/subscription features)
# Use test keys during development (from Stripe Dashboard → API keys)
# STRIPE_SECRET_KEY=your-stripe-secret-key-here
# STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here
# Growth tier price ID (create in Stripe Dashboard: €299/month recurring)
# STRIPE_GROWTH_PRICE_ID=your-stripe-price-id-here

# ============================================================================
# SECURITY - Authentication & Authorization
# ============================================================================

# JWT signature verification (Supabase Dashboard → Settings → API → JWT Secret)
# REQUIRED in production for HS256 projects. The process refuses to boot when
# APP_ENV or FLASK_ENV is production/prod and this is missing, unless
# SUPABASE_JWT_JWKS=1 (asymmetric signing keys only). Requests never fall
# open: a missing or short secret rejects the token.
# Must be the real JWT secret, at least 32 characters. A short placeholder is ignored.
# SUPABASE_JWT_SECRET=your-jwt-secret-here
#
# Optional. Defaults to {SUPABASE_URL}/auth/v1, which is what Supabase Auth writes
# on user access tokens. Set this only if the project uses a custom JWT issuer.
# SUPABASE_JWT_ISS=https://your-project.supabase.co/auth/v1
#
# Optional. Defaults to "authenticated" (Supabase user access tokens).
# SUPABASE_JWT_AUD=authenticated
#
# Set to 1 only when this Supabase project signs access tokens with ES256/RS256
# and you are intentionally not configuring SUPABASE_JWT_SECRET. Public keys are
# read from {SUPABASE_URL}/auth/v1/.well-known/jwks.json (override with SUPABASE_JWKS_URL).
# SUPABASE_JWT_JWKS=0
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
#
# Shared secret for POST /onboarding/process-jobs (header X-Cron-Key).
# The route refuses every request when this and AINM_SERVICE_KEY are both unset.
# PROCESS_JOBS_SECRET=generate-a-strong-random-secret-here
#
# Optional HMAC key for Twilio media-stream WebSocket tokens. When unset, the
# stream token is signed with TWILIO_AUTH_TOKEN. If neither is set, /voice/stream
# will not open a media stream.
# VOICE_STREAM_SIGNING_SECRET=
#
# Local only. Never set this in production; it is ignored when APP_ENV or
# FLASK_ENV is production/prod. Allows Twilio webhooks and the media-stream
# socket without a signature so a laptop can exercise voice without Twilio.
# TWILIO_ALLOW_UNSIGNED_WEBHOOKS=0

# Service-to-service auth key (Ainm backend → ExecFlex)
# Shared secret — set the same value in Ainm's config as EXECFLEX_SERVICE_KEY
# AINM_SERVICE_KEY=generate-a-strong-random-secret-here

# Smoke test bypass for CI/CD pipelines
# SMOKE_TEST_BYPASS_SECRET=your-smoke-test-secret
# SMOKE_TEST_USER_ID=a-valid-user-uuid

# ============================================================================
# OPTIONAL - App Configuration
# ============================================================================

# Environment (dev/prod)
# APP_ENV=dev
# Auto configured by
# PYTHON_VERSION=

# ============================================================================
# OPTIONAL - Candidate Sourcing
# ============================================================================
# People Data Labs (active provider — free tier: 100 searches/month)
# PDL_API_KEY=your-people-data-labs-api-key-here

# Apollo API key — currently DISABLED (paid plan required).
# Kept here for when we upgrade; re-enable by switching the import in
# routes/roles.py from sourcing_service back to apollo_service.
# APOLLO_API_KEY=your-apollo-api-key-here
